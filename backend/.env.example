# Environment
NODE_ENV=development
PORT=5000

# Required
MONGODB_URI=mongodb://127.0.0.1:27017/emar
JWT_SECRET=replace_with_strong_secret
JWT_ISSUER=emar-backend
JWT_AUDIENCE=emar-clients

# Required in non-development mode
# Comma-separated list
CORS_ALLOWED_ORIGINS=http://localhost:5000

# Optional
SEED_ON_BOOT=false
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX=10
JWT_EXPIRES_IN=7d
