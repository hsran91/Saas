# Environment
NODE_ENV=development
PORT=5000

# Required
MONGODB_URI=mongodb://127.0.0.1:27017/emar
JWT_SECRET=replace_with_strong_secret
JWT_ISSUER=emar-backend
JWT_AUDIENCE=emar-clients

# Required in non-development mode
# Comma-separated list
CORS_ALLOWED_ORIGINS=http://localhost:5000

# Optional
SEED_ON_BOOT=false
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX=10
JWT_EXPIRES_IN=7d
STORAGE_DRIVER=local
MAX_UPLOAD_FILE_SIZE_BYTES=5242880
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
METRICS_TOKEN=
EMAIL_ENABLED=false
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=
EMAIL_REPLY_TO=
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=
ACCESS_LOG_RETENTION_DAYS=365
JOB_POLL_INTERVAL_MS=3000
JOB_MAX_PER_TICK=20
REQUIRE_DB_TRANSACTIONS=false
