# Environment
NODE_ENV=production
PORT=5000

# Managed MongoDB production cluster (replica set or sharded)
MONGODB_URI=mongodb+srv://prod-user:replace_me@prod-cluster.example.mongodb.net/emar_prod?retryWrites=true&w=majority

# Required
JWT_SECRET=replace_with_production_secret
JWT_ISSUER=emar-backend
JWT_AUDIENCE=emar-clients
CORS_ALLOWED_ORIGINS=https://app.example.com

# Operational hardening
TRUST_PROXY=true
SEED_ON_BOOT=false
METRICS_TOKEN=replace_with_metrics_token
REQUIRE_DB_TRANSACTIONS=true

# Object storage
STORAGE_DRIVER=s3
MAX_UPLOAD_FILE_SIZE_BYTES=5242880
OBJECT_STORAGE_BUCKET=emar-prod-uploads
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=replace_me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace_me
OBJECT_STORAGE_PUBLIC_BASE_URL=https://emar-prod-uploads.s3.us-east-1.amazonaws.com
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Limits and retention
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX=10
JWT_EXPIRES_IN=7d
ACCESS_LOG_RETENTION_DAYS=2555
JOB_POLL_INTERVAL_MS=3000
JOB_MAX_PER_TICK=20